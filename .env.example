# --- Slack ---
# Create a Slack app at https://api.slack.com/apps (From scratch)
# OAuth & Permissions -> Bot Token Scopes: chat:write, channels:read, im:read
# Install to workspace -> copy the Bot User OAuth Token here (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here
# Invite the bot: /invite @YourBot in the channel. Channel can be ID (C0...) or name
SLACK_ALERT_CHANNEL=#yc-launches
# Optional separate channel for early founder signals (falls back to ALERT channel)
SLACK_EARLY_CHANNEL=

# --- Monitoring cadence ---
POLL_INTERVAL_HOURS=8
LOOKBACK_HOURS=24

# --- Pond agent server (optional) ---
POND_ACCESS_KEY=change-me
AGENT_PORT=8001

# Batches tracked (comma separated)
CURRENT_BATCHES=Summer 2026,Fall 2026,Winter 2027
